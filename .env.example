# Versus Space Environment Variables Template
# Copy this file to .env and fill in the actual values
# ⚠️ NEVER commit .env file with real values to Git

# Firebase Configuration
# Get these values from Firebase Console (Project Settings)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_AUTH_DOMAIN=your_auth_domain_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here

# Firebase Web Configuration (required for Web platform)
# Note: These are public-facing client IDs (not secrets)
# Example values shown below - replace with your project's values
FIREBASE_MESSAGING_SENDER_ID=636984750551
FIREBASE_APP_ID=1:636984750551:web:4cf3216b87a29dc7691b92

# External APIs
PERSPECTIVE_API_KEY=your_perspective_api_key_here
ALGOLIA_APP_ID=your_algolia_app_id_here
ALGOLIA_API_KEY=your_algolia_api_key_here

# Encoder API
ENCODER_API_URL=https://encoder-636984750551.asia-northeast3.run.app

# Default Assets
DEFAULT_CHARACTER_IMAGE_URL=your_default_character_image_url_here

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true