{
  "name": "versus-space-functions",
  "version": "2.0.0",
  "description": "Firebase Cloud Functions for Versus Space - Backend Phase 2",
  "author": "Versus Space Team",
  "license": "MIT",
  "main": "lib/index.js",
  "scripts": {
    "//": "=== Build Scripts ===",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf lib/",
    "rebuild": "npm run clean && npm run build",

    "//": "=== Firebase Scripts ===",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:prod": "firebase deploy --only functions --project production",
    "logs": "firebase functions:log",
    "logs:tail": "firebase functions:log --since 1m",

    "//": "=== Code Quality ===",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",

    "//": "=== Code Generation (Backend Phase 2) ===",
    "generate:dart": "node scripts/generate-dart-models.js",
    "generate:dart:single": "quicktype src/schemas/$SCHEMA.ts --lang dart --out ../../lib/features/$FEATURE/domain/models/$MODEL.dart --use-freezed --use-json-annotation --final-properties",
    "generate:rules": "node scripts/generate-firestore-rules.js",
    "generate:all": "npm run generate:dart && cd ../.. && dart run build_runner build --delete-conflicting-outputs",
    "generate:validate": "node scripts/validate-generated-models.js",

    "//": "=== Migration Scripts (FlutterFlow → Clean Architecture) ===",
    "migrate:add-camelcase": "node scripts/migrations/add-camelcase-fields.js",
    "migrate:remove-legacy": "node scripts/migrations/remove-legacy-fields.js",
    "migrate:validate": "node scripts/migrations/validate-migration.js",
    "migrate:dry-run": "DRY_RUN=true node scripts/migrations/add-camelcase-fields.js",

    "//": "=== Testing ===",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",

    "//": "=== Development Workflow ===",
    "dev": "npm run watch",
    "dev:emulator": "npm run build && firebase emulators:start",
    "dev:full": "concurrently \"npm:watch\" \"npm:serve\"",

    "//": "=== Pre-commit Hooks ===",
    "precommit": "npm run lint && npm run typecheck && npm test",
    "prepush": "npm run lint && npm run typecheck && npm run test:coverage",

    "//": "=== Phase 2 Validation ===",
    "validate:schemas": "node scripts/validate-zod-schemas.js",
    "validate:dart": "cd ../.. && dart analyze && flutter test",
    "validate:all": "npm run validate:schemas && npm run validate:dart"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "//": "=== Firebase ===",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",

    "//": "=== Validation (Backend Phase 2) ===",
    "zod": "^3.22.4",

    "//": "=== AI (Genkit Framework) ===",
    "@genkit-ai/ai": "^0.5.0",
    "@genkit-ai/firebase": "^0.5.0",
    "@genkit-ai/googleai": "^0.5.0",

    "//": "=== Utilities ===",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "//": "=== TypeScript ===",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.2.0",

    "//": "=== Linting & Formatting ===",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.0.0",

    "//": "=== Testing ===",
    "firebase-functions-test": "^3.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",

    "//": "=== Code Generation (Phase 2) ===",
    "quicktype": "^23.0.170",

    "//": "=== Development Tools ===",
    "concurrently": "^8.0.0",
    "nodemon": "^3.0.0"
  },
  "private": true,
  "keywords": [
    "firebase",
    "firebase-functions",
    "zod",
    "genkit",
    "quicktype",
    "clean-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/versus-space.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/versus-space/issues"
  }
}
