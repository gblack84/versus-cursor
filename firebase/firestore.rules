rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{parent}/notification/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /users/{parent}/settings/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    // 서버 시간 동기화를 위한 임시 컬렉션
    match /time_sync/{document} {
      // 인증된 사용자만 생성 가능
      allow create: if request.auth != null;
      // 본인이 생성한 문서만 읽기 가능
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // 수정 불가
      allow update: if false;
      // 본인이 생성한 문서만 삭제 가능
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    match /posts/{postId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null && (
        // 투표 필드와 타이머 관련 필드 업데이트 허용
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['votedUserIDsA', 'votedUserIDsB', 'votes_a', 'votes_b', 'vote_count_a', 'vote_count_b', 
                    'total_votes', 'last_vote_at', 'timer_started_at', 'timer_expiry_at', 'vote_request_status',
                    // AI 채팅 투표 관련 추가 필드 (camelCase)
                    'voteStartTime', 'voteEndTime', 'voteStatus', 'voteCompleted',
                    // Firebase Functions가 사용하는 snake_case 필드
                    'vote_start_time', 'vote_end_time', 'vote_status', 'vote_completed',
                    'vote_completed_at', 'vote_cancelled_at', 'vote_cancelled_reason',
                    // 알림 관련 필드
                    'notificationsSent', 'notificationsSentAt',
                    // 표시용 투표 수 (증폭된 수)
                    'display_votes_a', 'display_votes_b', 'display_percent_a', 'display_percent_b',
                    // 실제 투표 수
                    'actual_votes_a', 'actual_votes_b', 'actual_total_votes'])
        // 중복 투표 방지 (필드가 존재하는 경우에만 확인)
        && (
          (!('votedUserIDsA' in resource.data) || !(request.auth.uid in resource.data.votedUserIDsA))
          && (!('votedUserIDsB' in resource.data) || !(request.auth.uid in resource.data.votedUserIDsB))
        )
      );
      allow delete: if false;
    }

    match /posts/{parent}/images/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if true;
    }

    match /{path=**}/images/{document} {
      allow read: if true;
    }

    match /posts/{parent}/poll_details/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/poll_details/{document} {
      allow read: if true;
    }

    match /posts/{parent}/votes/{document} {
      allow create: if request.auth != null 
        && request.auth.uid != null
        && request.resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.keys().hasAll(['user', 'option', 'created_at'])
        && request.resource.data.keys().hasOnly(['user', 'option', 'created_at', 'from_chat']);
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/votes/{document} {
      allow read: if true;
    }


    match /posts/{parent}/votecounts/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/votecounts/{document} {
      allow read: if true;
    }


    match /posts/{parent}/video/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if true;
    }

    match /{path=**}/video/{document} {
      allow read: if true;
    }


    match /posts/{parent}/voteExpansionRequests/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/voteExpansionRequests/{document} {
      allow read: if true;
    }


    match /comments/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /comments/{parent}/likes/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/likes/{document} {
      allow read: if true;
    }


    match /comments/{parent}/dislikes/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/dislikes/{document} {
      allow read: if true;
    }


    match /chats/{chatId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null && (
        // AI 채팅방인 경우 (chatId에 'ai_assistant' 포함)
        (chatId.matches('.*ai_assistant.*') && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['last_message_content', 'last_message_at', 'last_message_sent_by', 
                     'participantIds', 'lastReadTimestamps']))
        ||
        // 일반 채팅방인 경우
        (request.auth.uid in resource.data.users && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['last_message', 'last_message_time', 'last_message_sent_by', 
                     // Flutter 코드에서 사용하는 필드명도 허용
                     'last_message_content', 'last_message_at', 'lastMessageContent', 'lastMessageAt',
                     'lastReadTimestamps']))
      );
      allow delete: if false;
    }

    match /chats/{parent}/friends_list/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/friends_list/{document} {
      allow read: if true;
    }


    match /chats/{parent}/messages/{document} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null && (
        // AI 채팅방인 경우 (parent에 'ai_assistant' 포함)
        (parent.matches('.*ai_assistant.*') && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['is_read', 'vote_status', 'card_status', 'user_voted', 'vote_choice', 
                     'vote_participated_at', 'vote_results', 'vote_end_time',
                     // 개별 사용자 투표 상태 추적 필드 추가
                     'user_votes', 'last_vote_update']))
        ||
        // 일반 채팅방인 경우
        (request.auth.uid in get(/databases/$(database)/documents/chats/$(parent)).data.users && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['is_read', 'vote_status', 'card_status', 'user_voted', 'vote_choice', 
                     'vote_participated_at', 'vote_results',
                     // 개별 사용자 투표 상태 추적 필드 추가
                     'user_votes', 'last_vote_update']))
      );
      allow delete: if false;
    }

    match /{path=**}/messages/{document} {
      allow read: if true;
    }


    match /group_chats/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /group_chats/{parent}/group_messages/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/group_messages/{document} {
      allow read: if true;
    }


    match /rankings/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /rankings/{parent}/ranked_posts/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/ranked_posts/{document} {
      allow read: if true;
    }


    match /searches/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.user_id
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'read_at']);
      allow delete: if false;
    }

    match /interest/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /interest/{parent}/weights/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/weights/{document} {
      allow read: if true;
    }


    match /user_contents/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /user_contents/{parent}/poll_details/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/poll_details/{document} {
      allow read: if true;
    }


    match /user_contents/{parent}/feed_details/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/feed_details/{document} {
      allow read: if true;
    }


    match /user_contents/{parent}/content_comments/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/content_comments/{document} {
      allow read: if true;
    }


    match /user_contents/{parent}/contents_likes/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/contents_likes/{document} {
      allow read: if true;
    }


    match /user_contents/{parent}/contents_interests/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/contents_interests/{document} {
      allow read: if true;
    }


    match /user_contents/{parent}/contents_shares/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/contents_shares/{document} {
      allow read: if true;
    }


    match /point/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /premium_users/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /point/{parent}/transactions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/transactions/{document} {
      allow read: if true;
    }


    match /client/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /jops_name/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /jops_category/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /users/{parent}/Chat_interest_jops/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /users/{parent}/Chat_history/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /characters/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /encodings/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    // users 컬렉션 규칙 (기본 users 컬렉션용)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
  }
}
