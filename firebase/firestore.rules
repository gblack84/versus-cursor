rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{parent}/notification/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /users/{parent}/settings/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    // 서버 시간 동기화를 위한 임시 컬렉션
    match /timeSync/{document} {
      // 인증된 사용자만 생성 가능
      allow create: if request.auth != null;
      // 본인이 생성한 문서만 읽기 가능
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // 수정 불가
      allow update: if false;
      // 본인이 생성한 문서만 삭제 가능
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // ============================================================================
    // 🆕 Idempotency & Sharded Counter 시스템 (Server-Only)
    // ============================================================================

    // Idempotency 컬렉션 (Server-only)
    // IdempotencyService가 중복 방지를 위해 사용
    match /idempotency/{document} {
      allow read: if false;
      allow write: if false;
    }

    // Counters 컬렉션 (Server-only)
    // ShardUtils가 샤드 카운터를 관리
    // Cloud Function (incrementCounter)만 접근 가능
    match /counters/{counterId}/shards/{shardId} {
      allow read: if false;
      allow write: if false;
    }

    // ============================================================================
    // Posts 컬렉션
    // ============================================================================

    match /posts/{postId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null && (
        // ✅ Step 1: 클라이언트가 업데이트 가능한 필드만 허용 (Whitelist)
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['votedUserIDsA', 'votedUserIDsB', 'lastVoteAt',
                    'timerStartedAt', 'timerExpiryAt', 'voteRequestStatus',
                    // AI 채팅 투표 관련 필드
                    'voteStartTime', 'voteEndTime', 'voteStatus', 'voteCompleted',
                    'voteCompletedAt', 'voteCancelledAt', 'voteCancelledReason',
                    // 알림 관련 필드
                    'notificationsSent', 'notificationsSentAt',
                    // 표시용 투표 수 (증폭된 수)
                    'displayVotesA', 'displayVotesB', 'displayPercentA', 'displayPercentB'])

        // ✅ Step 2: 카운터 필드 명시적 차단 (Server-Only, Blacklist)
        // Cloud Functions에서만 업데이트 가능
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['votesA', 'votesB', 'totalVotes', 'counterLastUpdated'])

        // ✅ Step 3: 중복 투표 방지 (필드가 존재하는 경우에만 확인)
        && (
          (!('votedUserIDsA' in resource.data) || !(request.auth.uid in resource.data.votedUserIDsA))
          && (!('votedUserIDsB' in resource.data) || !(request.auth.uid in resource.data.votedUserIDsB))
        )
      );
      allow delete: if false;
    }

    match /posts/{parent}/images/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if true;
    }

    match /{path=**}/images/{document} {
      allow read: if true;
    }

    match /posts/{parent}/pollDetails/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/pollDetails/{document} {
      allow read: if true;
    }

    match /posts/{parent}/votes/{document} {
      allow create: if request.auth != null
        && request.auth.uid != null
        && request.resource.data.user == /databases/$(database)/documents/users/$(request.auth.uid)
        && request.resource.data.keys().hasAll(['user', 'option', 'createdAt'])
        && request.resource.data.keys().hasOnly(['user', 'option', 'createdAt', 'eventId', 'fromChat']);
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/votes/{document} {
      allow read: if true;
    }


    match /posts/{parent}/votecounts/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/votecounts/{document} {
      allow read: if true;
    }


    match /posts/{parent}/video/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if true;
    }

    match /{path=**}/video/{document} {
      allow read: if true;
    }


    match /posts/{parent}/voteExpansionRequests/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/voteExpansionRequests/{document} {
      allow read: if true;
    }


    match /comments/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /comments/{parent}/likes/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/likes/{document} {
      allow read: if true;
    }


    match /comments/{parent}/dislikes/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/dislikes/{document} {
      allow read: if true;
    }


    match /chats/{chatId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null && (
        // AI 채팅방인 경우 (chatId에 'aiAssistant' 포함)
        (chatId.matches('.*aiAssistant.*') && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastMessageContent', 'lastMessageAt', 'lastMessageSentBy', 
                     'participantIds', 'lastReadTimestamps']))
        ||
        // 일반 채팅방인 경우
        (request.auth.uid in resource.data.users && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastMessage', 'lastMessageTime', 'lastMessageSentBy', 
                     // 추가 필드명
                     'lastMessageContent', 'lastMessageAt',
                     'lastReadTimestamps']))
      );
      allow delete: if false;
    }

    match /chats/{parent}/friendsList/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/friendsList/{document} {
      allow read: if true;
    }


    match /chats/{parent}/messages/{document} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null && (
        // AI 채팅방인 경우 (parent에 'aiAssistant' 포함)
        (parent.matches('.*aiAssistant.*') && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isRead', 'voteStatus', 'cardStatus', 'userVoted', 'voteChoice', 
                     'voteParticipatedAt', 'voteResults', 'voteEndTime',
                     // 개별 사용자 투표 상태 추적 필드 추가
                     'userVotes', 'lastVoteUpdate']))
        ||
        // 일반 채팅방인 경우
        (request.auth.uid in get(/databases/$(database)/documents/chats/$(parent)).data.users && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isRead', 'voteStatus', 'cardStatus', 'userVoted', 'voteChoice', 
                     'voteParticipatedAt', 'voteResults',
                     // 개별 사용자 투표 상태 추적 필드 추가
                     'userVotes', 'lastVoteUpdate']))
      );
      allow delete: if false;
    }

    match /{path=**}/messages/{document} {
      allow read: if true;
    }


    match /groupChats/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /groupChats/{parent}/groupMessages/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/groupMessages/{document} {
      allow read: if true;
    }


    match /rankings/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /rankings/{parent}/rankedPosts/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/rankedPosts/{document} {
      allow read: if true;
    }


    match /searches/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if true;
      allow read: if true;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'readAt']);
      allow delete: if false;
    }

    // ============================================================================
    // 🆕 Guard Analytics (Debug-Only, Phase 5)
    // ============================================================================

    // Guard Analytics 컬렉션
    // Route Guard 실행 이벤트 추적 (개발/디버깅 용도)
    // - DebugLogPage의 Guard Analytics 탭에서 실시간 조회
    // - AuthGuard가 자동으로 이벤트 기록
    match /guard_analytics/{eventId} {
      // 읽기: 인증된 사용자만 (개발 환경에서 Debug Tools 접근 가능)
      // Production에서는 kDebugMode 체크로 UI 자체가 차단됨
      allow read: if request.auth != null;

      // 쓰기: 인증된 사용자 (AuthGuard가 이벤트 기록)
      // null userId도 허용 (비로그인 상태에서 Guard 실행 가능)
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['eventId', 'timestamp', 'attemptedPath', 'result', 'reason'])
        && request.resource.data.keys().hasOnly(['eventId', 'timestamp', 'attemptedPath', 'redirectPath', 'result', 'userId', 'reason'])
        && request.resource.data.result in ['blocked', 'allowed'];

      // 업데이트 불가 (Append-Only 로그)
      allow update: if false;

      // 삭제: 본인 이벤트만 또는 관리자 (향후 role 기반 확장 가능)
      // 현재는 GuardAnalyticsService.clearAllEvents()로만 삭제 (Cloud Function 또는 Admin SDK)
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.uid in ['ADMIN_UID_1', 'ADMIN_UID_2']); // 실제 관리자 UID로 교체
    }

    match /interest/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /interest/{parent}/weights/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/weights/{document} {
      allow read: if true;
    }


    match /userContents/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /userContents/{parent}/pollDetails/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/pollDetails/{document} {
      allow read: if true;
    }


    match /userContents/{parent}/feedDetails/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/feedDetails/{document} {
      allow read: if true;
    }


    match /userContents/{parent}/contentComments/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/contentComments/{document} {
      allow read: if true;
    }


    match /userContents/{parent}/contentsLikes/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/contentsLikes/{document} {
      allow read: if true;
    }


    match /userContents/{parent}/contentsInterests/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/contentsInterests/{document} {
      allow read: if true;
    }


    match /userContents/{parent}/contentsShares/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/contentsShares/{document} {
      allow read: if true;
    }


    match /point/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /premiumUsers/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /point/{parent}/transactions/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/transactions/{document} {
      allow read: if true;
    }


    match /client/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /jopsName/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /jopsCategory/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /users/{parent}/chatInterestJops/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /users/{parent}/chatHistory/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if request.auth.uid == parent;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /characters/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /encodings/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    // users 컬렉션 규칙 (기본 users 컬렉션용)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
  }
}
