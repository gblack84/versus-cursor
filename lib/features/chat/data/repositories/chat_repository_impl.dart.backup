import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:get_it/get_it.dart';

import '/features/chat/domain/models/message.dart';
import '/features/chat/domain/repositories/i_chat_repository.dart';
import '/backend/models/chat/messages_model.dart';
import '/backend/models/migration/model_adapter.dart';
import '/backend/repositories/chat_repository.dart' as legacy;
import '/services/cache/unified_cache_service.dart';

/// Chat Repository 구현체
/// 
/// ModelAdapter를 사용하여 레거시 모델을 Feature 모델로 변환
/// Option B 마이그레이션 전략의 핵심 구현
class ChatRepositoryImpl implements IChatRepository {
  final legacy.ChatRepository _chatRepository;
  final UnifiedCacheService _cacheService;
  final FirebaseFirestore _firestore;
  
  ChatRepositoryImpl({
    legacy.ChatRepository? chatRepository,
    UnifiedCacheService? cacheService,
    FirebaseFirestore? firestore,
  }) : _chatRepository = chatRepository ?? legacy.ChatRepository(),
       _cacheService = cacheService ?? GetIt.I<UnifiedCacheService>(),
       _firestore = firestore ?? GetIt.instance<FirebaseFirestore>();
  
  @override
  Future<Message?> getMessage(String messageId) async {
    try {
      // 캐시 확인
      final cached = await _cacheService.get('message_$messageId');
      if (cached != null) {
        return cached as Message;
      }
      
      // Firestore에서 직접 조회
      final doc = await _firestore
          .collectionGroup('messages')
          .where(FieldPath.documentId, isEqualTo: messageId)
          .limit(1)
          .get();
      
      if (doc.docs.isEmpty) return null;
      
      final legacyMessage = MessagesModel.fromSnapshot(doc.docs.first);
      final message = ModelAdapter.toMessage(legacyMessage);
      
      // 캐시 저장
      await _cacheService.set('message_$messageId', message);
      
      return message;
    } catch (e) {
      print('Error getting message: $e');
      return null;
    }
  }
  
  @override
  Future<List<Message>> getChatMessages(
    String chatId, {
    int limit = 50,
    Message? lastMessage,
  }) async {
    try {
      // 캐시 확인
      final cacheKey = 'chat_messages_$chatId';
      final cached = await _cacheService.get(cacheKey);
      if (cached != null && lastMessage == null) {
        return cached as List<Message>;
      }
      
      // Firestore 쿼리
      Query query = _firestore
          .collection('chats')
          .doc(chatId)
          .collection('messages')
          .orderBy('createdAt', descending: true)
          .limit(limit);
      
      if (lastMessage?.reference != null) {
        query = query.startAfterDocument(
          await lastMessage!.reference!.get()
        );
      }
      
      final snapshot = await query.get();
      
      final messages = snapshot.docs
          .map((doc) => MessagesModel.fromSnapshot(doc))
          .map((legacy) => ModelAdapter.toMessage(legacy))
          .toList();
      
      // 첫 페이지만 캐싱
      if (lastMessage == null && messages.isNotEmpty) {
        await _cacheService.set(cacheKey, messages);
      }
      
      return messages;
    } catch (e) {
      print('Error getting chat messages: $e');
      return [];
    }
  }
  
  @override
  Future<Message> sendMessage(Message message) async {
    try {
      // Feature 모델을 레거시 형식으로 변환
      final messageData = ModelAdapter.fromMessage(message);
      
      // Firestore에 저장
      final chatRef = _firestore.collection('chats').doc(message.chatId);
      final messageRef = await chatRef.collection('messages').add(messageData);
      
      // 생성된 메시지 반환
      final createdMessage = message.copyWith(
        id: messageRef.id,
        reference: messageRef,
      );
      
      // 캐시 무효화
      await _cacheService.delete('chat_messages_${message.chatId}');
      
      // 마지막 메시지 업데이트
      await updateLastMessage(message.chatId, createdMessage);
      
      return createdMessage;
    } catch (e) {
      throw Exception('Failed to send message: $e');
    }
  }
  
  @override
  Future<Message> updateMessage(Message message) async {
    try {
      // Feature 모델을 레거시 형식으로 변환
      final updateData = ModelAdapter.fromMessage(message);
      
      // Firestore 업데이트
      await message.reference?.update(updateData);
      
      // 캐시 무효화
      await _cacheService.delete('message_${message.id}');
      await _cacheService.delete('chat_messages_${message.chatId}');
      
      return message;
    } catch (e) {
      throw Exception('Failed to update message: $e');
    }
  }
  
  @override
  Future<bool> deleteMessage(String messageId) async {
    try {
      // 메시지 조회
      final message = await getMessage(messageId);
      if (message == null) return false;
      
      // Firestore에서 삭제
      await message.reference?.delete();
      
      // 캐시 무효화
      await _cacheService.delete('message_$messageId');
      await _cacheService.delete('chat_messages_${message.chatId}');
      
      return true;
    } catch (e) {
      print('Error deleting message: $e');
      return false;
    }
  }
  
  @override
  Stream<List<Message>> watchChatMessages(String chatId) {
    return _firestore
        .collection('chats')
        .doc(chatId)
        .collection('messages')
        .orderBy('createdAt', descending: true)
        .snapshots()
        .map((snapshot) => snapshot.docs
            .map((doc) => MessagesModel.fromSnapshot(doc))
            .map((legacy) => ModelAdapter.toMessage(legacy))
            .toList());
  }
  
  @override
  Stream<Message?> watchMessage(String messageId) {
    return _firestore
        .collectionGroup('messages')
        .where(FieldPath.documentId, isEqualTo: messageId)
        .limit(1)
        .snapshots()
        .map((snapshot) {
          if (snapshot.docs.isEmpty) return null;
          final legacy = MessagesModel.fromSnapshot(snapshot.docs.first);
          return ModelAdapter.toMessage(legacy);
        });
  }
  
  @override
  Future<Message> createVoteMessage({
    required String chatId,
    required String senderId,
    required String postId,
    required Map<String, dynamic> voteData,
  }) async {
    try {
      // 투표 메시지 생성
      final message = Message(
        id: '',
        chatId: chatId,
        senderId: senderId,
        content: '투표를 요청했습니다',
        type: MessageType.vote,
        timestamp: DateTime.now(),
        createdAt: DateTime.now(),
        updatedAt: DateTime.now(),
        metadata: {
          'postId': postId,
          'voteData': voteData,
        },
      );
      
      return await sendMessage(message);
    } catch (e) {
      throw Exception('Failed to create vote message: $e');
    }
  }
  
  @override
  Future<void> markAsRead(String messageId, String userId) async {
    try {
      final message = await getMessage(messageId);
      if (message == null) return;
      
      await message.reference?.update({
        'readBy': FieldValue.arrayUnion([userId]),
        'updatedAt': FieldValue.serverTimestamp(),
      });
      
      // 캐시 무효화
      await _cacheService.delete('message_$messageId');
    } catch (e) {
      print('Error marking message as read: $e');
    }
  }
  
  @override
  Future<void> updateLastMessage(String chatId, Message message) async {
    try {
      await _firestore.collection('chats').doc(chatId).update({
        'lastMessage': message.content,
        'lastMessageAt': FieldValue.serverTimestamp(),
        'lastMessageSender': message.senderId,
      });
    } catch (e) {
      print('Error updating last message: $e');
    }
  }
  
  @override
  Future<List<Message>> getAIChatMessages(
    String userId, {
    int limit = 50,
  }) async {
    try {
      // AI 채팅방 ID 생성
      final aiChatId = 'ai_assistant_$userId';
      
      return await getChatMessages(aiChatId, limit: limit);
    } catch (e) {
      print('Error getting AI chat messages: $e');
      return [];
    }
  }
  
  @override
  Future<String> createChat({
    required List<String> participantIds,
    String? name,
  }) async {
    try {
      final chatData = {
        'participantIds': participantIds,
        'name': name,
        'createdAt': FieldValue.serverTimestamp(),
        'lastMessageAt': FieldValue.serverTimestamp(),
      };
      
      final chatRef = await _firestore.collection('chats').add(chatData);
      
      return chatRef.id;
    } catch (e) {
      throw Exception('Failed to create chat: $e');
    }
  }
  
  @override
  Future<bool> deleteChat(String chatId) async {
    try {
      // 모든 메시지 삭제
      final messages = await _firestore
          .collection('chats')
          .doc(chatId)
          .collection('messages')
          .get();
      
      for (final doc in messages.docs) {
        await doc.reference.delete();
      }
      
      // 채팅방 삭제
      await _firestore.collection('chats').doc(chatId).delete();
      
      // 캐시 무효화
      await _cacheService.delete('chat_messages_$chatId');
      
      return true;
    } catch (e) {
      print('Error deleting chat: $e');
      return false;
    }
  }
}