                                  ),
                                ],
                              ),
                            ].cast<Widget>().divide(SizedBox(width: 4.0)),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
