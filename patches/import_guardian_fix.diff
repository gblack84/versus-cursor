+// Domain interface for authentication services
+// This replaces direct imports of auth_util.dart in presentation layer
+
+import 'package:firebase_auth/firebase_auth.dart';
+import '../../../profile/domain/models/user_profile.dart';
+
+abstract class IAuthService {
+  // Authentication state
+  User? get currentUser;
+  bool get loggedIn;
+  
+  // Authentication methods  
+  Future<User?> signInWithEmail(String email, String password);
+  Future<User?> createUserWithEmail(String email, String password);
+  Future<void> signOut();
+  Future<void> sendPasswordResetEmail(String email);
+  
+  // Phone authentication
+  Future<void> beginPhoneAuth({
+    required String phoneNumber,
+    required void Function(PhoneAuthCredential) onCodeSent,
+    required void Function(FirebaseAuthException) onVerificationFailed,
+  });
+  
+  // User management
+  Future<UserProfile?> getCurrentUserProfile();
+}

diff --git a/lib/features/auth/data/services/auth_service_impl.dart b/lib/features/auth/data/services/auth_service_impl.dart
new file mode 100644
index 0000000..5c8f2e8
--- /dev/null
+++ b/lib/features/auth/data/services/auth_service_impl.dart
@@ -0,0 +1,62 @@
+// Implementation of IAuthService using existing auth_util logic
+// This decouples presentation layer from direct auth_util imports
+
+import 'package:firebase_auth/firebase_auth.dart';
+import '../../domain/services/i_auth_service.dart';
+import '../../../profile/domain/models/user_profile.dart';
+import 'auth_util.dart';
+
+class AuthServiceImpl implements IAuthService {
+  @override
+  User? get currentUser => currentUserReference;
+  
+  @override
+  bool get loggedIn => loggedIn;
+  
+  @override
+  Future<User?> signInWithEmail(String email, String password) async {
+    try {
+      final result = await signInWithEmail(email, password);
+      return result;
+    } catch (e) {
+      rethrow;
+    }
+  }
+  
+  @override
+  Future<User?> createUserWithEmail(String email, String password) async {
+    try {
+      final result = await createAccountWithEmail(email, password);
+      return result;
+    } catch (e) {
+      rethrow;
+    }
+  }
+  
+  @override
+  Future<void> signOut() async {
+    return await signOutUser();
+  }
+  
+  @override
+  Future<void> sendPasswordResetEmail(String email) async {
+    return await resetPassword(email);
+  }
+  
+  @override
+  Future<void> beginPhoneAuth({
+    required String phoneNumber,
+    required void Function(PhoneAuthCredential) onCodeSent,
+    required void Function(FirebaseAuthException) onVerificationFailed,
+  }) async {
+    // Implement phone authentication logic from auth_util
+    throw UnimplementedError('Phone auth needs to be extracted from auth_util');
+  }
+  
+  @override
+  Future<UserProfile?> getCurrentUserProfile() async {
+    final user = currentUser;
+    if (user == null) return null;
+    
+    // TODO: Implement user profile fetching through repository
+    throw UnimplementedError('User profile fetching needs repository');
+  }
+}

